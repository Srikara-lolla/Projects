pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        ENVIRONMENT      = "dev"
        TF_IN_AUTOMATION = "true"
        EMAIL_TO         = "srikarlolla2468@gmail.com"
    }

    stages {

        stage('Verify Workspace') {
            steps {
                sh '''
                    pwd
                    ls -la
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                dir('Terraform') {
                    sh '''
                        terraform init \
                            -input=false \
                            -no-color
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('Terraform') {
                    sh '''
                        terraform validate \
                            -no-color
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('Terraform') {
                    script {

                        sh '''
                            set +e

                            terraform plan \
                            -detailed-exitcode \
                            -no-color \
                            -out=tfplan > plan1.log 2>&1

                            TF_EXIT=$?

                            echo $TF_EXIT > tf_exit"

                            if [ $TF_EXIT -eq 0 ]; then

                                echo "No infrastructure drift detected" > full-plan.log

                            elif [ $TF_EXIT -eq 2 ]; then

                                terraform show -no-color tfplan > full-plan.log

                            else

                                echo "Terraform plan failed" > full-plan.log

                            fi

                            echo "========== Terraform Drift Summary ==========" > summary.log
                            grep -A50 -E "^  #|^Plan:" full-plan.log >> summary.log || true
                        '''

                        env.PLAN_EXIT = readFile('tf_exit').trim()

                        currentBuild.description = "Terraform Plan Exit Code: ${env.PLAN_EXIT}"

                        echo "Terraform Plan Exit Code: ${env.PLAN_EXIT}"

                        echo "========== Terraform Plan Summary =========="

                        sh '''
                            if [ -s summary.log ]; then
                                cat summary.log
                            else
                                echo "No summary generated"
                            fi
                        '''

                        echo "============================================"

                        archiveArtifacts artifacts: 'plan.log,full-plan.log,summary.log'

                        if (env.PLAN_EXIT == "0") {
                            echo "No Drift detected"
                        }
                        else if (env.PLAN_EXIT == "2") {
                            unstable("Terraform Drift detected")
                        }
                        else {
                            error("Terraform Plan failed")
                        }
                    }
                }
            }
        }
    }

    post {

        success {
            echo "No Drift"

            emailext(
                subject: "SUCCESS: Terraform Drift Check - ${env.JOB_NAME}",
                body: """
                        Hello,

                            Terraform drift check completed successfully.

                            Job Name : ${env.JOB_NAME}
                            Build No : ${env.BUILD_NUMBER}
                            Status   : SUCCESS

                            No infrastructure drift was detected.

                            Build URL: ${env.BUILD_URL}
                        """,
                to: env.EMAIL_TO
            )
        }

        unstable {
            echo "Terraform Drift detected"

            emailext(
                subject: "ALERT: Terraform Drift Detected - ${env.JOB_NAME}",
                body: """
                    Hello,

                        Terraform drift has been detected.

                        Job Name : ${env.JOB_NAME}
                        Build No : ${env.BUILD_NUMBER}
                        Status   : UNSTABLE

                        Please review the attached Terraform plan and summary.

                        Build URL: ${env.BUILD_URL}
                """,
                to: env.EMAIL_TO,
                attachmentsPattern: "Terraform/plan.log,Terraform/full-plan.log,Terraform/summary.log"
            )
            cleanWs()
        }

        failure {
            echo "Terraform Pipeline Failed"

            emailext(
                subject: "FAILED: Terraform Pipeline - ${env.JOB_NAME}",
                body: """
                    Hello,

                        The Terraform pipeline execution failed.

                        Job Name : ${env.JOB_NAME}
                        Build No : ${env.BUILD_NUMBER}
                        Status   : FAILED

                        Please review the Jenkins console logs.

                        Build URL: ${env.BUILD_URL}
                """,
                to: env.EMAIL_TO
            )
            cleanWs()
        }
    }
}
