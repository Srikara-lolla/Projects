pipeline {
    agent any
    environment {
    TF_IN_AUTOMATION = "true"
    TF_CLI_ARGS = "-no-color"
        }
    stages {
        stage('Verify Workspace') {
            steps {
                sh '''
                    pwd
                    ls -la
                '''
            }
        }
        stage('Terraform Init') {
            steps {
                dir('Terraform') {
                    sh '''
                        terraform init \
                            -input=false
                    '''
                }
            }
        }
        stage('Terraform Validate') {
            steps {
                dir('Terraform') {
                    sh '''
                        terraform validate
                    '''
                }
            }
        }
        stage('Terraform Plan') {
            steps {
                dir('Terraform') {
                    sh '''
                        terraform plan \
                        -detailed-exitcode
                    '''
                }
            }
        }
    }
}
