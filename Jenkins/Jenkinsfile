pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        ENVIRONMENT = "dev"
        TF_IN_AUTOMATION = "true"
    }

    stages {

        stage('Verify Workspace') {
            steps {
                sh '''
                    pwd
                    ls -la
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                dir('Terraform') {
                    sh '''
                        terraform init \
                            -input=false \
                            -no-color
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('Terraform') {
                    sh '''
                        terraform validate \
                            -no-color
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('Terraform') {
                    script {

                        sh '''
                            set +e
                            terraform plan \
                            -detailed-exitcode \
                            -no-color \
                            > plan.log 2>&1
                            echo $? > tf_exit
                            //Optional features
                            grep -E "Plan:|No changes" plan.log > summary.log || true
                        '''
                        env.PLAN_EXIT = readFile('tf_exit').trim()
                        echo "Terraform Plan Exit Code: ${env.PLAN_EXIT}"
                        //Optional features
                        if (fileExists('summary.log')) {
                            echo "Terraform Plan Summary:"
                                sh 'cat summary.log'
                         }
                        archiveArtifacts artifacts: 'plan.log,summary.log'

                        if (env.PLAN_EXIT == "0") {
                            echo "No Drift detected"
                        } 
                        else if (env.PLAN_EXIT == "2") {
                            unstable("Terraform Drift detected")
                        } 
                        else {
                            error("Terraform Plan failed")
                        }
                    }
                }
            }
        }
    }

    post {

        success {
            echo "No Drift"
        }
        unstable {
            echo "Terraform Drift detected"
        }
        failure {
            echo "Terraform Pipeline Failed"
        }
        always {
            cleanWs()
        }
    }
}
